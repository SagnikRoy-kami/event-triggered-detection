{
  // Windows interpreter path. On macOS / Linux use "${workspaceFolder}/.venv/bin/python".
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/src"],
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "terminal.integrated.env.windows": { "PYTHONPATH": "${workspaceFolder}/src" },
  "terminal.integrated.env.linux": { "PYTHONPATH": "${workspaceFolder}/src" },
  "terminal.integrated.env.osx": { "PYTHONPATH": "${workspaceFolder}/src" },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true
  },
  // keep VS Code fast: never index the dataset or the run outputs
  "search.exclude": {
    "data/raw": true,
    "data/processed": true,
    "data/interim": true,
    "outputs": true,
    "models": true,
    ".venv": true
  },
  "files.watcherExclude": {
    "**/data/raw/**": true,
    "**/data/processed/**": true,
    "**/outputs/**": true,
    "**/.venv/**": true
  },
  "[python]": { "editor.rulers": [120] },
  "yaml.schemas": {}
}
